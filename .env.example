# =============================================================================
# Trelk Support Platform — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ─── Bot Configuration ────────────────────────────────────────────────────────
SUPPORT_BOT_TOKEN=your_telegram_bot_token_here
NOTIFICATION_BOT_TOKEN=your_notification_bot_token_here
WEBHOOK_SECRET=generate_with_openssl_rand_hex_32
WEBHOOK_URL=https://support.example.com

# Bot username (optional, for display purposes)
BOT_USERNAME=TrelkSupportBot

# ─── Update Mode ─────────────────────────────────────────────────────────────
# Set POLLING_ENABLED=true for local development without a public URL
POLLING_ENABLED=false
POLLING_TIMEOUT=30

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8443
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Host IP for TLS cert lookup (used when serving self-signed certs)
IP_HOST=127.0.0.1

# Public URL of the API
PUBLIC_URL=https://api.example.com

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/trelk_support

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=generate_with_openssl_rand_hex_64
JWT_EXPIRES_IN=7d

# ─── Dashboard & CORS ────────────────────────────────────────────────────────
DASHBOARD_URL=https://dashboard.example.com
DASHBOARD_PUBLIC_URL=https://dashboard.example.com
CORS_ORIGIN=https://dashboard.example.com,http://localhost:5173

# ─── Support Team ────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs for initial support agents
SUPPORT_AGENT_IDS=123456789,987654321
# Optional: Telegram group ID for escalated tickets
SUPPORT_GROUP_ID=

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── Telegram API Proxy (optional) ────────────────────────────────────────────
# Override the Telegram API base URL (useful behind a local MTProxy)
TELEGRAM_API_BASE_URL=https://api.telegram.org
