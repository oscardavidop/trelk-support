# Trelk Support Bot Configuration
# Copy this file to .env and fill in your values

# ============= BOT CONFIGURATION =============
SUPPORT_BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_SECRET=your_random_webhook_secret_here

# ============= SERVER CONFIGURATION =============
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Webhook URL (your server's public URL)
WEBHOOK_URL=https://support.trelk.site

# ============= DATABASE =============
MONGODB_URI=mongodb://localhost:27017/trelk_support

# ============= JWT AUTHENTICATION =============
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ============= SUPPORT TEAM =============
# Comma-separated list of Telegram user IDs for support agents
SUPPORT_AGENT_IDS=123456789,987654321

# Support group chat ID for escalated tickets (optional)
SUPPORT_GROUP_ID=

# ============= DASHBOARD =============
DASHBOARD_URL=https://support.trelk.site
CORS_ORIGIN=https://support.trelk.site,http://localhost:5173

# ============= LOGGING =============
LOG_LEVEL=info
